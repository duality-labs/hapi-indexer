{
  "name": "duality-hapi-indexer",
  "version": "2.0.0-spacebox",
  "description": "A Node.js SSE wrapper for Spacebox indexer data",
  "main": "dist/server.js",
  "scripts": {
    "prepare": "[ -d '.git' ] && husky install || echo 'skipping husky'",
    "docker": "docker compose up --build --abort-on-container-exit || true && docker compose down",
    "build": "esbuild src/server.ts --bundle --platform=node --outdir=dist",
    "dev:build": "npm run build -- --watch",
    "dev:start": "nodemon dist/server.js --exec node",
    "dev": "npm run build && concurrently npm:dev:*",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": "^18.19.0",
    "npm": "^10.2.3"
  },
  "dependencies": {
    "@clickhouse/client": "^1.10.1",
    "@hapi/accept": "^6.0.3",
    "@hapi/hapi": "^21.3.1",
    "esbuild": "^0.17.18",
    "sql-template-tag": "^5.1.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/hapi": "^18.0.8",
    "@types/node": "^18.16.3",
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    "concurrently": "^8.0.1",
    "eslint": "^8.39.0",
    "eslint-config-prettier": "^8.8.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2",
    "nodemon": "^2.0.22",
    "prettier": "2.8.8",
    "typescript": "^5.0.4"
  },
  "lint-staged": {
    "**/*.{mjs,js,jsx,ts,tsx,json,css,scss,html,md,yaml,yml}": [
      "prettier --write"
    ],
    "**/*.{mjs,js,jsx,ts,tsx}": [
      "eslint --max-warnings 0"
    ]
  }
}
